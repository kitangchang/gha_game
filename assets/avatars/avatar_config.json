{
  "_doc": "Avatar layers, stacked in this order (first = bottom). Every PNG in assets/avatars/<layer name>/ is loaded at start-up (press F5 in game to reload). All pieces share one canvas size. Layers with a 'tint' are drawn in greyscale and coloured in game: a palette name below, or 'team' for the analyst's team colour. A file with '_fixed' in its name is never tinted. 'name_back.png' is drawn behind everything (e.g. long hair behind the shoulders) whenever 'name.png' is picked.",
  "canvas": [128, 128],
  "pixel_art": false,
  "portrait_crop": [14, 4, 100, 100],
  "layers": [
    {"name": "base",        "tint": "team", "required": true},
    {"name": "skin",        "tint": "skin_tones", "required": true},
    {"name": "clothes"},
    {"name": "tired_eyes",  "tint": "skin_tones", "condition": "tired"},
    {"name": "eyes"},
    {"name": "mouth"},
    {"name": "nose",        "tint": "skin_tones"},
    {"name": "hair", "tint": "hair_colours", "chance_none": {"f": 0.0, "m": 0.12}},
    {"name": "lanyard",     "chance_none": 0.94},
    {"name": "hats",        "tint": "team", "chance_none": 0.95},
    {"name": "glasses",     "chance_none": 0.93}
  ],
  "palettes": {
    "skin_tones": [[255, 226, 200], [244, 204, 170], [230, 180, 140], [205, 150, 110],
                   [170, 115, 80], [130, 88, 60], [96, 64, 44]],
    "hair_colours": [[40, 32, 30], [40, 32, 30], [70, 50, 38], [110, 74, 48], [150, 98, 60],
                     [196, 150, 90], [222, 196, 140], [176, 176, 180], [236, 236, 236],
                     [168, 64, 52], [92, 150, 200]]
  },
  "overlays": {"tired": "overlays/tired.png"},
  "tired_fatigue": 70
}
